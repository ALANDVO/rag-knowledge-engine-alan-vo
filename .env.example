# LLM Configuration
OPENAI_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# OIDC/Keycloak Configuration
OIDC_ISSUER_URL=http://localhost:8080/realms/rag-engine
OIDC_CLIENT_ID=rag-knowledge-engine
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback
SESSION_SECRET=generate-a-random-secret-here

# Server
HOST=0.0.0.0
PORT=8000
DEMO_MODE=false

# Vector Store
VECTOR_DB_PATH=data/vectors.db

# Chunking
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
TOP_K=5
REQUIRE_SSO=true